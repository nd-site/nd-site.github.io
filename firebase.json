{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "ndsite",
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": true,
    "retainedBackups": 1,
    "redirects": [
      {
        "source": "/eduspace",
        "destination": "/edu/",
        "type": 301
      },
      {
        "source": "/eduspace/:path*",
        "destination": "/edu/:path",
        "type": 301
      },
      {
        "source": "/admin/eduspace",
        "destination": "/admin/edu/",
        "type": 301
      },
      {
        "source": "/admin/eduspace/:path*",
        "destination": "/admin/edu/:path",
        "type": 301
      },
      {
        "source": "/psychology/**",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/utils/**",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/media/**",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/games/**",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/chat/**",
        "destination": "/",
        "type": 302
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "vite.config.ts",
      "tsconfig.json",
      "tsconfig.node.json",
      "capacitor.config.ts",
      "env.json",
      "push_secrets.ps1",
      "set_gemini_key.js",
      "functions/**",
      ".github/**",
      "_agent/**",
      "scan2word/**",
      "android/**",
      "ND_bot_LotusChat/**",
      "live_download/**",
      "src/**",
      "dist/**",
      "*.cjs",
      "*.ts",
      "**/*.exe",
      "**/*.cmd",
      "**/*.ps1",
      "**/*.sh",
      "**/*.bat",
      "**/*.dll",
      "**/*.so",
      "**/*.bin"
    ],
    "rewrites": [
      {
        "source": "/edu/timetable/**",
        "destination": "/edu/timetable/index.html"
      },
      {
        "source": "/edu/timtable/**",
        "destination": "/edu/timetable/index.html"
      },
      {
        "source": "/admin/edu/timetable/**",
        "destination": "/edu/timetable/index.html"
      },
      {
        "source": "/edu/poem/**",
        "destination": "/edu/poem/index.html"
      },
      {
        "source": "/edu/poemnd/**",
        "destination": "/edu/poem/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}