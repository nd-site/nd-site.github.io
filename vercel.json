{
  "version": 2,
  "buildCommand": "npm run build:edu && node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.writeFileSync('dist/index.html','')\"",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/psychology/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/utils/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/media/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/games/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/chat/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/auth?action=$1"
    }
  ]
}
